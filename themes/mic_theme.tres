[gd_resource type="Theme" load_steps=4 format=3]

[sub_resource type="SystemFont" id="SystemFont_symbols"]
font_names = PackedStringArray("Segoe UI Symbol", "Segoe UI Historic", "DejaVu Sans", "Arial Unicode MS")

[sub_resource type="SystemFont" id="SystemFont_main"]
fallbacks = Array[Font]([SubResource("SystemFont_symbols")])
font_names = PackedStringArray("Segoe UI", "Selawik", "Arial")

[sub_resource type="StyleBoxLine" id="StyleBoxLine_separator"]
color = Color(0.168627, 0.188235, 0.25098, 1)
thickness = 1

[resource]
default_font = SubResource("SystemFont_main")
default_font_size = 16
CheckButton/colors/font_color = Color(0.909804, 0.921569, 0.94902, 1)
CheckButton/colors/font_hover_color = Color(1, 1, 1, 1)
CheckButton/colors/font_pressed_color = Color(0.941176, 0.65098, 0.235294, 1)
HSeparator/styles/separator = SubResource("StyleBoxLine_separator")
Label/colors/font_color = Color(0.909804, 0.921569, 0.94902, 1)
